# Qdrant Native Portable 1.0.0 - non-secret overrides.
# Export values in your shell before `bash qdrant.sh setup`.
# Effective settings are persisted outside the repository in $BASE_DIR/runtime.env.

# Environment policy (development remains backward-compatible).
QNP_ENV=development              # development | production
QNP_RUNTIME=auto                 # auto | native | docker
QNP_TOPOLOGY=single              # single only in this revision
QNP_CREATE_DEMO_DATA=auto        # auto | 0 | 1 (production auto => 0)
QNP_SECRET_POLICY=auto           # auto | generate | require-env (production auto => require-env)
QNP_ALLOW_DEMO_TUNNEL=0          # explicit production Quick Tunnel acknowledgement
QNP_KAGGLE_PERSISTENCE=none      # none | files | variables-and-files
# QDRANT_BIND_HOST=127.0.0.1     # native default; Docker default is 0.0.0.0

QDRANT_VERSION=1.18.3
QDRANT_PROFILE=auto              # auto | low-memory | balanced-lite | balanced-memory | balanced | performance
PROCESS_MODE=auto                # auto | current-user | service-user
DEPLOYMENT_MODE=auto             # auto | minimal | proxy
PUBLIC_MODE=auto                 # auto | cloudflare-quick | platform | none

# Optional custom storage root. Platform defaults are selected automatically.
# BASE_DIR=/path/to/qdrant-data

QDRANT_HTTP_PORT=6333
QDRANT_ENABLE_GRPC=0
QDRANT_GRPC_PORT=6334
PORT=9090
PROXY_BIND=127.0.0.1

QDRANT_MAX_REQUEST_SIZE_MB=128
ENABLE_CORS=false
START_TUNNEL=0

# Security controls
QDRANT_STRICT_MODE=1
QDRANT_STRICT_MAX_QUERY_LIMIT=1000
QDRANT_STRICT_MAX_TIMEOUT=30
QDRANT_STRICT_MAX_HNSW_EF=512
QDRANT_STRICT_ALLOW_EXACT=false
QDRANT_STRICT_MAX_RESIDENT_MEMORY_PERCENT=85
QDRANT_STRICT_SEARCH_MAX_BATCHSIZE=64
QDRANT_JWT_RBAC=0

CLOUDFLARED_VERSION=latest
# QDRANT_SHA256=
# CLOUDFLARED_SHA256=

# Optional backup destination; use a persistent/local/cloud-mounted destination
# for copies of completed snapshots, not for the live Qdrant storage.
# BACKUP_DIR=/path/to/backups

# Secrets are intentionally omitted:
# export QDRANT_API_KEY='...'
# export QDRANT_READ_ONLY_API_KEY='...'
